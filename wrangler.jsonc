{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "universe",
  "compatibility_date": "2026-10-02",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "include": [
      "index.html",
      "assets/**",
      "portrait/**",
      "music/**",
      "love-letter.json",
      "metadata.json"
    ]
  }
}
