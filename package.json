{
  "name": "universe-for-my-gf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build": "node scripts/verify-static.mjs",
    "check": "npm run build && npm run visual:check && npm run performance:check && npm run server:check && npm run intro:check && npm run experience:check && npm run solar:check",
    "visual:check": "node scripts/verify-visual-pass.mjs",
    "server:check": "node scripts/verify-server-config.mjs",
    "performance:check": "node scripts/verify-performance.mjs",
    "intro:check": "node scripts/verify-intro.mjs",
    "experience:check": "node scripts/verify-experience.mjs",
    "nebula:check": "node scripts/verify-nebula.mjs",
    "solar:check": "node scripts/verify-solar.mjs",
    "deploy": "npx wrangler deploy --config ./wrangler.jsonc",
    "preview": "npx wrangler dev --config ./wrangler.jsonc"
  },
  "dependencies": {
    "express": "4.22.3",
    "wrangler": "4.147.0"
  }
}
